{
  "schema": 1,
  "id": "yocto-master",
  "tier": "development",
  "yocto_version": "master",
  "bitbake_version": "master",
  "snapshot": "Moving development branches",
  "repositories": [
    {
      "name": "openembedded-core",
      "url": "https://github.com/openembedded/openembedded-core.git",
      "ref": "refs/heads/master",
      "sparse_paths": [
        ".templateconf",
        "meta/",
        "scripts/",
        "oe-init-build-env"
      ]
    },
    {
      "name": "bitbake",
      "url": "https://github.com/openembedded/bitbake.git",
      "ref": "refs/heads/master",
      "sparse_paths": [
        "*"
      ]
    },
    {
      "name": "meta-openembedded",
      "url": "https://github.com/openembedded/meta-openembedded.git",
      "ref": "refs/heads/master",
      "sparse_paths": [
        "meta-networking/",
        "meta-oe/",
        "meta-python/"
      ]
    }
  ],
  "layers": [
    {
      "name": "openembedded-core",
      "repository": "openembedded-core",
      "path": "meta",
      "minimum_files": 1500
    },
    {
      "name": "meta-oe",
      "repository": "meta-openembedded",
      "path": "meta-oe",
      "minimum_files": 1000
    },
    {
      "name": "meta-python",
      "repository": "meta-openembedded",
      "path": "meta-python",
      "minimum_files": 650
    },
    {
      "name": "meta-networking",
      "repository": "meta-openembedded",
      "path": "meta-networking",
      "minimum_files": 230
    }
  ],
  "syntax_metrics": {
    "minimum_structured_nodes": 68000,
    "maximum_unknown_nodes": 200
  },
  "bitbake": {
    "init_repository": "openembedded-core",
    "template": "meta/conf/templates/default",
    "target": "core-image-minimal",
    "additional_layers": [
      "meta-openembedded/meta-oe",
      "meta-openembedded/meta-python",
      "meta-openembedded/meta-networking"
    ],
    "semantic_probes": [
      {
        "name": "core-image-minimal-metadata",
        "target": "core-image-minimal",
        "variables": [
          "PN",
          "PV",
          "PR",
          "DEPENDS",
          "RDEPENDS",
          "SRC_URI",
          "SRCREV"
        ]
      }
    ]
  }
}
